<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- Viewport tag is crucial for mobile responsiveness -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Kalika Business Advisors | Corporate Excellence</title>
    
    <!-- Tab Icon matching your circular seal -->
    <link rel="icon" href="logo.png" type="image/png">
    
    <!-- Premium Global Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            /* Ultra-Luxury Corporate Palette: Midnight Navy & Champagne Gold */
            --primary: #080C11;        
            --primary-light: #121A25;  
            --accent: #D4AF37;         
            --accent-hover: #C5A028;   
            --background: #FDFDFD;     
            --surface: #FFFFFF;        
            --text-main: #111827;      
            --text-muted: #4B5563;     
            --border: #E5E7EB;         
            --gold-border: rgba(212, 175, 55, 0.3);
            
            --radius-sm: 4px;
            --radius-md: 8px;
            --radius-lg: 16px;
            
            --shadow-soft: 0 10px 40px -10px rgba(0,0,0,0.05);
            --shadow-gold: 0 15px 40px -15px rgba(212, 175, 55, 0.25);
            
            --max-width: 1320px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-font-smoothing: antialiased; }
        html { scroll-behavior: smooth; }
        /* Prevent horizontal scroll bugs on mobile */
        body { background-color: var(--background); color: var(--text-muted); font-family: 'Inter', sans-serif; line-height: 1.8; overflow-x: hidden; }
        
        h1, h2, h3 { font-family: 'Playfair Display', serif; color: var(--text-main); line-height: 1.2; }
        h4, h5 { font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text-main); letter-spacing: 0.05em; }
        a { text-decoration: none; color: inherit; transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
        img { max-width: 100%; display: block; object-fit: cover; }
        
        .container { max-width: var(--max-width); margin: 0 auto; padding: 0 5%; }
        
        section { padding: 130px 0; }
        .section-header { margin-bottom: 80px; max-width: 800px; position: relative; }
        .section-header h5 { color: var(--accent); text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.8rem; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 12px; }
        .section-header h5::after { content: ''; width: 40px; height: 1px; background: var(--accent); display: block; }
        /* Dynamic Typography */
        .section-header h2 { font-size: clamp(2rem, 5vw, 3.8rem); margin-bottom: 25px; font-weight: 500; }
        .section-header p { font-size: clamp(1rem, 2vw, 1.15rem); font-weight: 300; color: var(--text-muted); max-width: 650px; }
        
        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 450px), 1fr)); gap: 60px; }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 40px; }

        /* Navigation */
        nav { position: fixed; top: 0; width: 100%; z-index: 100; transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); padding: 25px 0; }
        nav.scrolled { background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(25px); padding: 15px 0; border-bottom: 1px solid rgba(0,0,0,0.03); box-shadow: var(--shadow-soft); }
        nav.scrolled .nav-links a { color: var(--text-main); }
        .nav-container { display: flex; justify-content: space-between; align-items: center; }
        
        .logo { display: flex; align-items: center; gap: 18px; text-decoration: none; position: relative; z-index: 101; }
        .logo img { height: 70px; width: auto; transition: all 0.5s ease; }
        .logo-text { display: flex; flex-direction: column; justify-content: center; font-family: 'Plus Jakarta Sans', sans-serif;}
        .logo-main { font-size: 1.15rem; font-weight: 700; color: white; letter-spacing: 0.05em; transition: color 0.5s; line-height: 1.1; }
        .logo-sub { font-size: 0.65rem; font-weight: 600; color: var(--accent); letter-spacing: 0.15em; text-transform: uppercase; margin-top: 4px;}
        
        #navbar:not(.scrolled) .logo img { filter: invert(1) brightness(2); }
        #navbar.scrolled .logo img { filter: none; height: 55px; }
        #navbar.scrolled .logo-main { color: var(--primary); }

        .nav-links { display: flex; gap: 30px; align-items: center; } 
        .nav-links a { font-size: 0.8rem; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; color: rgba(255,255,255,0.9); text-transform: uppercase; letter-spacing: 0.1em; position: relative;}
        .nav-links a:hover { color: var(--accent) !important; }
        
        .nav-links a:not(.nav-cta)::after {
            content: ''; position: absolute; bottom: -8px; left: 0;
            width: 0; height: 1px; background: var(--accent); transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .nav-links a.active { color: var(--accent) !important; }
        .nav-links a.active::after { width: 100%; }

        .nav-cta { 
            background: var(--accent); color: var(--primary) !important; padding: 10px 24px; 
            border-radius: 2px; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.1em;
            border: 1px solid var(--accent); white-space: nowrap; transition: all 0.4s ease;
        }
        .nav-cta:hover { 
            background: transparent; color: var(--accent) !important;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.4); transform: translateY(-2px);
        }

        .menu-toggle { display: none; font-size: 1.6rem; color: white; cursor: pointer; z-index: 101; transition: color 0.4s; }
        nav.scrolled .menu-toggle { color: var(--primary); }

        /* Hero Section */
        .hero {
            position: relative; padding: 200px 0 100px; min-height: 100vh;
            display: flex; align-items: center; background-color: var(--primary); overflow: hidden;
        }
        .hero-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('<%= data.hero_bg %>'); background-size: cover; background-position: center; z-index: 0;
            transform: scale(1.08); animation: slowZoom 25s ease-out forwards;
        }
        @keyframes slowZoom { 100% { transform: scale(1); } }
        .hero-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, rgba(8,12,17,0.90) 0%, rgba(8,12,17,0.4) 100%); z-index: 1;
        }
        .hero .container { position: relative; z-index: 2; }
        
        .hero-tag { 
            display: inline-flex; align-items: center; gap: 12px; padding: 10px 24px; 
            background: rgba(212, 175, 55, 0.08); color: var(--accent); border-radius: 100px; 
            font-size: 0.75rem; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; 
            text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 40px; 
            backdrop-filter: blur(10px); border: 1px solid rgba(212, 175, 55, 0.2); 
        }
        /* Mobile-friendly clamp scale */
        .hero h1 { font-size: clamp(2.8rem, 8vw, 6.5rem); font-weight: 500; margin-bottom: 30px; max-width: 1000px; color: white; letter-spacing: -0.01em; line-height: 1.15;}
        .hero p { font-size: clamp(1rem, 3vw, 1.4rem); max-width: 700px; margin-bottom: 50px; color: rgba(255,255,255,0.7); font-weight: 300; line-height: 1.7;}
        
        .btn-group { display: flex; gap: 20px; flex-wrap: wrap; }
        .btn { 
            display: inline-flex; align-items: center; justify-content: center; gap: 12px; 
            padding: 20px 42px; border-radius: var(--radius-sm); font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); cursor: pointer; border: 1px solid transparent; 
        }
        .btn-primary { background: var(--accent); color: var(--primary); border-color: var(--accent); }
        .btn-primary:hover { background: transparent; color: var(--accent); transform: translateY(-4px); box-shadow: var(--shadow-gold); }
        .btn-secondary { background: transparent; border-color: rgba(255,255,255,0.3); color: white; backdrop-filter: blur(5px); }
        .btn-secondary:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-4px); }

        /* Clients Section */
        .clients-section { padding: 90px 0; background: var(--surface); border-bottom: 1px solid rgba(0,0,0,0.03); }
        .clients-section .section-header { margin-bottom: 50px; text-align: center; margin-left: auto; margin-right: auto; }
        .clients-section .section-header h5 { justify-content: center; }
        .clients-section .section-header h5::after { display: none; }
        .client-grid { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: clamp(30px, 6vw, 100px); opacity: 0.8; }
        .client-logo { display: flex; align-items: center; justify-content: center; gap: 10px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(1.2rem, 3vw, 1.5rem); font-weight: 700; color: #9CA3AF; letter-spacing: 0.05em; transition: all 0.5s ease; filter: grayscale(100%); cursor: pointer; }
        .client-logo i { font-size: clamp(1.8rem, 4vw, 2.2rem); }
        .client-logo img { max-height: 100px; width: auto; max-width: 180px; object-fit: contain; }
        .client-logo:hover { color: var(--accent); filter: grayscale(0%); transform: scale(1.05); opacity: 1; }

        /* Video Showcase */
        .video-section { padding-top: 130px; padding-bottom: 0; background: var(--background); }
        .video-wrapper { position: relative; width: 100%; overflow: hidden; border-radius: var(--radius-md); box-shadow: var(--shadow-soft); aspect-ratio: 16/9; background: #000; }
        .video-wrapper iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }

        /* Leadership */
        #leadership { background: var(--background); }
        .founder-layout { display: flex; gap: 80px; align-items: center; }
        .founder-image-wrapper { position: relative; flex: 1; border-radius: var(--radius-sm); overflow: hidden; height: 650px; }
        .founder-image-wrapper img { width: 100%; height: 100%; object-fit: cover; filter: sepia(20%) hue-rotate(-10deg) saturate(80%); transition: all 0.8s ease; }
        .founder-image-wrapper:hover img { filter: none; transform: scale(1.03); }
        .founder-image-wrapper::after { content: ''; position: absolute; top: 20px; left: 20px; right: 20px; bottom: 20px; border: 1px solid rgba(212, 175, 55, 0.4); z-index: 2; pointer-events: none; transition: all 0.8s ease; }
        .founder-image-wrapper:hover::after { top: 10px; left: 10px; right: 10px; bottom: 10px; border-color: var(--accent); }
        
        .founder-content { flex: 1; position: relative; }
        .founder-content::before { content: '"'; position: absolute; top: -60px; left: -30px; font-family: 'Playfair Display', serif; font-size: 150px; color: rgba(212, 175, 55, 0.1); z-index: 0; line-height: 1; }
        .founder-quote { position: relative; z-index: 1; font-size: clamp(1.2rem, 3vw, 1.55rem); font-family: 'Playfair Display', serif; font-style: italic; line-height: 1.6; color: var(--text-main); margin-bottom: 45px; }
        .founder-signature { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 4vw, 2.2rem); color: var(--primary); margin-bottom: 8px; font-weight: 500; }
        .founder-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); font-weight: 700; }

        /* Services */
        .card { background: var(--surface); border: 1px solid rgba(0,0,0,0.04); border-radius: var(--radius-sm); overflow: hidden; transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; box-shadow: 0 4px 20px rgba(0,0,0,0.02); }
        .card:hover { border-color: var(--gold-border); box-shadow: var(--shadow-gold); transform: translateY(-12px); }
        .card-img-wrapper { width: 100%; height: 280px; overflow: hidden; position: relative; }
        .card-img-wrapper img { width: 100%; height: 100%; transition: transform 1s ease; filter: brightness(0.9) grayscale(20%); object-fit: cover; }
        .card:hover .card-img-wrapper img { transform: scale(1.1); filter: brightness(1) grayscale(0%); }
        .card-content { padding: 50px 40px; flex-grow: 1; display: flex; flex-direction: column; background: var(--surface); position: relative; }
        .card-icon-floating { position: absolute; top: -35px; left: 40px; width: 70px; height: 70px; background: var(--primary); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 1.6rem; z-index: 10; border-radius: var(--radius-sm); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .card h3 { font-size: 1.7rem; margin-bottom: 18px; margin-top: 15px; font-weight: 600; }
        .card p { font-weight: 300; font-size: 1.05rem; }
        .card-meta { margin-top: auto; padding-top: 30px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--text-muted); }

        /* Experts Section */
        .expert-section { 
            background-color: var(--primary);
            background-image: linear-gradient(rgba(8,12,17,0.75), rgba(8,12,17,0.80)), url('namche-bazaar-village-way-everest-base-camp-khumbu-region-nepal-himalaya.jpg');
            background-size: cover; background-position: center; background-attachment: fixed;
            color: white; position: relative; border-top: 1px solid rgba(212, 175, 55, 0.15); border-bottom: 1px solid rgba(212, 175, 55, 0.15); 
        }
        .expert-section .container { position: relative; z-index: 1; }
        .expert-section h2 { color: white; }
        .expert-section p { color: rgba(255,255,255,0.8); }
        .expert-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 35px; }
        .expert-item { padding: 45px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-sm); backdrop-filter: blur(12px); transition: all 0.5s ease; }
        .expert-item:hover { background: rgba(255,255,255,0.08); border-color: rgba(212, 175, 55, 0.4); transform: translateY(-8px); box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5); }
        .expert-item h4 { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 18px; font-size: 1.2rem; color: white; }
        .expert-item i { color: var(--accent); font-size: 1.3rem; margin-top: 3px; }
        .expert-item p { font-size: 0.95rem; color: rgba(255,255,255,0.7); font-weight: 300; line-height: 1.7; }

        /* Insights */
        .insight-card { border-bottom: 1px solid var(--border); padding-bottom: 45px; transition: all 0.4s; }
        .insight-card:hover { transform: translateX(10px); }
        .insight-card:hover h3 { color: var(--accent); }
        .insight-meta { font-size: 0.75rem; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; color: var(--accent); margin-bottom: 18px; text-transform: uppercase; letter-spacing: 0.15em; }
        .insight-card h3 { font-size: 1.7rem; font-weight: 500;}
        .insight-link { display: inline-flex; align-items: center; gap: 10px; margin-top: 25px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.8rem; font-weight: 700; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.1em; transition: color 0.4s; }
        .insight-link:hover { color: var(--accent); }

        /* FAQ & Forms */
        .split-section { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 8vw, 120px); align-items: start; }
        details { border-bottom: 1px solid rgba(0,0,0,0.05); padding: 30px 0; }
        summary { font-family: 'Playfair Display', serif; font-size: clamp(1.2rem, 3vw, 1.4rem); color: var(--primary); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; font-weight: 500; }
        summary::-webkit-details-marker { display: none; }
        summary::after { content: '\f067'; font-family: 'FontAwesome'; color: var(--accent); font-size: 1rem; transition: transform 0.5s ease; }
        details[open] summary::after { transform: rotate(135deg); }
        .faq-content { padding-top: 25px; color: var(--text-muted); font-weight: 300; padding-right: 40px; font-size: 1.05rem; }

        .form-card { 
            background-color: var(--primary);
            background-image: linear-gradient(rgba(8,12,17,0.70), rgba(18,26,37,0.85)), url('ChatGPT Image Aug 21, 2026, 12_10_03 PM.png');
            background-size: cover; background-position: center; border-radius: var(--radius-sm); 
            padding: clamp(35px, 6vw, 70px); /* Scales well on mobile */
            box-shadow: 0 30px 60px -15px rgba(0,0,0,0.4); color: white; position: relative; overflow: hidden; 
        }
        .form-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: var(--accent); z-index: 2;}
        .form-card * { position: relative; z-index: 2; } 
        .form-group { margin-bottom: 30px; }
        .form-label { display: block; font-size: 0.75rem; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(255,255,255,0.7); margin-bottom: 12px; }
        /* Font size must be 16px (1rem) minimum on mobile inputs to prevent iOS auto-zoom */
        .form-control { width: 100%; padding: 18px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.15); border-radius: var(--radius-sm); font-family: inherit; font-size: 1rem; color: white; transition: all 0.4s; backdrop-filter: blur(5px); }
        .form-control:focus { outline: none; border-color: var(--accent); background: rgba(0,0,0,0.6); box-shadow: 0 0 20px rgba(212, 175, 55, 0.15); }
        .form-control::placeholder { color: rgba(255,255,255,0.3); }

        /* Floating WhatsApp Button */
        .whatsapp-float {
            position: fixed; bottom: 40px; right: 40px; width: 65px; height: 65px;
            background-color: #25d366; color: #FFF; border-radius: 50%; 
            display: flex; align-items: center; justify-content: center; font-size: 32px;
            box-shadow: 0px 10px 30px rgba(37, 211, 102, 0.4); z-index: 1000;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            animation: pulse-wa 2.5s infinite;
        }
        .whatsapp-float i { margin-top: 2px; margin-left: 2px; }
        .whatsapp-float:hover {
            transform: translateY(-8px) scale(1.05); box-shadow: 0px 15px 35px rgba(37, 211, 102, 0.6); color: white;
            animation: none;
        }

        /* Back to Top Button */
        .back-to-top {
            position: fixed; bottom: -80px; right: 48px; width: 48px; height: 48px;
            background-color: var(--accent); color: var(--primary); border-radius: 50%;
            display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
            box-shadow: var(--shadow-gold); z-index: 999; transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            opacity: 0; visibility: hidden;
        }
        .back-to-top.show { bottom: 120px; opacity: 1; visibility: visible; }
        .back-to-top:hover { transform: translateY(-5px); background-color: var(--primary); color: var(--accent); border: 1px solid var(--accent); }

        @keyframes pulse-wa {
            0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6); }
            70% { box-shadow: 0 0 0 18px rgba(37, 211, 102, 0); }
            100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
        }

        /* FOOTER */
        footer { 
            position: relative; background-color: var(--primary);
            background-image: linear-gradient(rgba(8,12,17,0.85), rgba(8,12,17,0.90)), url('Basantapur.jpg');
            background-size: cover; background-position: center; color: white; 
            padding: 80px 0 30px; border-top: 1px solid rgba(255,255,255,0.05); 
        }
        footer .container { position: relative; z-index: 2; }
        .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 50px; margin-bottom: 50px; }
        .footer-logo img { height: 100px; filter: invert(1) brightness(2); margin-bottom: 25px; transition: opacity 0.4s; }
        .footer-logo:hover img { opacity: 0.8; }
        .footer-text { color: rgba(255,255,255,0.7); font-weight: 300; margin-bottom: 30px; font-size: 1.05rem; line-height: 1.7; max-width: 480px; }
        .footer-col h4 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.15em; color: white; margin-bottom: 30px; }
        .footer-col ul { list-style: none; }
        .footer-col ul li { margin-bottom: 18px; font-weight: 300; }
        .footer-col ul li a { color: rgba(255,255,255,0.7); transition: color 0.4s; }
        .footer-col ul li a:hover { color: var(--accent); }
        .footer-bottom { 
            border-top: 1px solid rgba(255,255,255,0.08); padding-top: 30px; 
            display: flex; justify-content: space-between; align-items: center; 
            color: rgba(255,255,255,0.5); font-size: 0.85rem; font-weight: 300; flex-wrap: wrap; gap: 15px;
        }
        
        .social-links { display: flex; gap: 15px; }
        .social-links a { width: 45px; height: 45px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; transition: all 0.5s ease; color: white; background: rgba(0,0,0,0.2); backdrop-filter: blur(5px); }
        .social-links a:hover { background: var(--accent); border-color: var(--accent); color: var(--primary); transform: translateY(-4px); }

        /* Animations */
        .reveal { opacity: 0; transform: translateY(40px); transition: 1s cubic-bezier(0.16, 1, 0.3, 1); }
        .reveal.active { opacity: 1; transform: translateY(0); }
        .delay-1 { transition-delay: 0.15s; }
        .delay-2 { transition-delay: 0.3s; }

        /* =========================================
           MOBILE RESPONSIVE QUERIES 
           ========================================= */
        
        @media (max-width: 1024px) {
            .founder-layout { flex-direction: column; gap: 50px; }
            .founder-image-wrapper { height: 450px; width: 100%; }
            .split-section { grid-template-columns: 1fr; gap: 60px; }
            section { padding: 100px 0; }
            .section-header { margin-bottom: 60px; }
        }
        
        @media (max-width: 768px) {
            /* Navbar adjustments */
            nav { padding: 15px 0; }
            .menu-toggle { display: block; }
            .nav-links {
                position: fixed; top: 0; right: -100%; width: 100%; max-width: 320px; height: 100vh;
                background: var(--surface); flex-direction: column; padding-top: 100px;
                transition: right 0.5s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: -20px 0 50px rgba(0,0,0,0.1);
                align-items: flex-start; padding-left: 40px; z-index: 100;
            }
            .nav-links.active { right: 0; }
            .nav-links a { color: var(--text-main) !important; font-size: 1rem; width: 100%; margin-bottom: 25px; }
            .nav-links a::after { left: 0; transform: none; }
            .nav-cta { margin-top: 20px; display: inline-block; text-align: center; width: calc(100% - 40px) !important; margin-left: 0;}
            
            .logo img { height: 50px; }
            .logo-main { font-size: 1rem; }
            .logo-sub { font-size: 0.6rem; }
            #navbar.scrolled .logo img { height: 45px; }
            .menu-toggle.active { color: var(--primary) !important; position: fixed; right: 5%; }
            
            /* Section layout adjustments */
            section { padding: 70px 0; }
            .section-header { margin-bottom: 45px; }
            .grid-2, .grid-3 { gap: 30px; }
            
            /* Hero adjustments */
            .hero { padding: 150px 0 80px; min-height: 80vh; text-align: left; } /* Kept left aligned for better text wrapping */
            .hero h1 { margin-bottom: 20px; }
            .hero p { margin-bottom: 40px; font-size: 1.05rem; }
            .btn-group { flex-direction: column; width: 100%; }
            .btn-group .btn { width: 100%; }
            
            /* Founder Image scaling down */
            .founder-image-wrapper { height: 350px; }
            .founder-content::before { font-size: 100px; top: -45px; left: -15px; }
            
            /* Footer adjustments */
            footer { padding: 60px 0 30px; }
            .footer-bottom { flex-direction: column; text-align: center; gap: 20px; }
            
            /* Shrink floating buttons slightly to save screen space */
            .whatsapp-float { bottom: 20px; right: 20px; width: 55px; height: 55px; font-size: 28px; }
            .back-to-top { right: 25px; width: 44px; height: 44px; font-size: 1.1rem; } 
            .back-to-top.show { bottom: 90px; } /* Sits above the smaller WhatsApp button */
        }

        @media (max-width: 480px) {
            /* Extra small phone tweaks */
            .hero h1 { font-size: 2.5rem; }
            .card-content { padding: 40px 25px 30px; }
            .card-icon-floating { left: 25px; }
            .expert-item { padding: 35px 25px; }
            .form-card { padding: 35px 25px; }
            .split-section { gap: 40px; }
            .client-grid { gap: 30px; }
            .client-logo i { font-size: 1.8rem; }
            .client-logo { font-size: 1.1rem; }
        }

        /* Startup Notice Modal */
        .notice-modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(8, 12, 17, 0.85); backdrop-filter: blur(8px);
            z-index: 9999; display: flex; align-items: center; justify-content: center;
            opacity: 0; visibility: hidden; transition: all 0.5s ease;
        }
        .notice-modal-overlay.active { opacity: 1; visibility: visible; }
        .notice-modal {
            background: var(--surface); padding: 50px; border-radius: var(--radius-sm);
            border: 1px solid var(--gold-border); box-shadow: var(--shadow-gold);
            max-width: 500px; width: 90%; text-align: center; position: relative;
            transform: translateY(20px); transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .notice-modal-overlay.active .notice-modal { transform: translateY(0); }
        .notice-modal h3 { font-family: 'Playfair Display', serif; color: var(--accent); margin-bottom: 20px; font-size: 1.8rem; }
        .notice-modal p { color: var(--text-muted); margin-bottom: 30px; font-size: 1.05rem; }
        .notice-modal .btn { width: 100%; }
        .notice-close {
            position: absolute; top: 15px; right: 20px; background: transparent; border: none;
            color: var(--text-muted); font-size: 1.5rem; cursor: pointer; transition: color 0.3s;
        }
        .notice-close:hover { color: var(--accent); }
    </style>

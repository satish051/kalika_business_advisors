<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard - Node Serverless</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f4f4f5; color: #333; margin: 0; }
        .sidebar { width: 250px; background: #080C11; color: white; position: fixed; height: 100vh; padding: 20px; box-sizing: border-box; }
        .sidebar h2 { color: #D4AF37; margin-top: 0; font-size: 1.2rem; margin-bottom: 40px; }
        .sidebar a { color: #ccc; text-decoration: none; display: block; margin-bottom: 15px; }
        .sidebar a:hover { color: #fff; }
        .main-content { margin-left: 250px; padding: 40px; }
        .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 30px; }
        h3 { border-bottom: 1px solid #eee; padding-bottom: 10px; margin-top: 0; }
        .form-group { margin-bottom: 20px; }
        label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.9rem; }
        input[type="text"], input[type="url"], textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-family: inherit; }
        .btn { padding: 12px 24px; background: #080C11; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .btn:hover { background: #D4AF37; color: #080C11; }
        .alert { padding: 15px; margin-bottom: 20px; border-radius: 4px; }
        .alert-success { background: #d4edda; color: #155724; }
        .alert-danger { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body>

    <div class="sidebar">
        <h2>Kalika Admin</h2>
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/settings">Security Settings</a>
        <a href="/" target="_blank">View Website</a>
        <a href="/admin/logout" style="color:#ff4444; margin-top: 50px;">Logout</a>
    </div>

    <div class="main-content">
        <h2>Vercel Node.js Dashboard</h2>
        
        <% if (success_msg) { %>
            <div class="alert alert-success"><%= success_msg %></div>
        <% } %>
        <% if (error_msg) { %>
            <div class="alert alert-danger"><%= error_msg %></div>
        <% } %>

        <form method="POST" action="/admin/dashboard" enctype="multipart/form-data">
            
            <div class="card">
                <h3>Hero Section</h3>
                <div class="form-group">
                    <label>Hero Title (Max 100 chars)</label>
                    <input type="text" name="hero_title" maxlength="100" value="<%= data.hero_title %>" required>
                </div>
                <div class="form-group">
                    <label>Hero Description (Max 500 chars)</label>
                    <textarea name="hero_description" rows="3" maxlength="500" required><%= data.hero_description %></textarea>
                </div>
                <div class="form-group">
                    <label>Hero Background Image (Vercel Blob)</label>
                    <input type="file" name="hero_bg_file" accept="image/jpeg, image/png, image/webp">
                    <small style="word-break: break-all;">Current: <%= data.hero_bg %></small>
                </div>
            </div>

            <div class="card">
                <h3>Founder Section</h3>
                <div class="form-group">
                    <label>Founder Image (Vercel Blob)</label>
                    <input type="file" name="founder_img_file" accept="image/jpeg, image/png, image/webp">
                    <small style="word-break: break-all;">Current: <%= data.founder_img %></small>
                </div>
            </div>

            <div class="card">
                <h3>Video Section</h3>
                <div class="form-group">
                    <label>Video URL (YouTube/Vimeo)</label>
                    <input type="url" name="video_url" value="<%= data.video_url %>" required>
                </div>
            </div>

            <div class="card">
                <h3>Notices (Popup Modal)</h3>
                <div id="notices-container">
                    <!-- Javascript will populate this -->
                </div>
                <button type="button" class="btn" onclick="addNotice()" style="background:#4CAF50;margin-top:10px;">+ Add Notice</button>
                <input type="hidden" name="notices_json" id="notices_json">
            </div>

            <div class="card">
                <h3>Our Esteemed Clientele</h3>
                <div id="clients-container">
                    <!-- Javascript will populate this -->
                </div>
                <button type="button" class="btn" onclick="addClient()" style="background:#4CAF50;margin-top:10px;">+ Add Client</button>
                <input type="hidden" name="clients_json" id="clients_json">
            </div>

            <button type="submit" class="btn">Save to Vercel KV</button>
        </form>
    </div>

    <script>
        let notices = <%- JSON.stringify(data.notices || []) %>;
        
        // Backwards compatibility for single notice
        const fallbackNotice = <%- JSON.stringify(data.notice || null) %>;
        if (notices.length === 0 && fallbackNotice) {
            notices.push(fallbackNotice);
        }

        function renderNotices() {
            const container = document.getElementById('notices-container');
            container.innerHTML = '';
            notices.forEach((n, idx) => {
                if (!n) return; // skip invalid notices
                container.innerHTML += `
                    <div style="border: 1px solid #eee; padding: 15px; margin-bottom: 15px; border-radius: 4px; position:relative;">
                        <button type="button" onclick="removeNotice(${idx})" style="position:absolute; right:15px; top:15px; background:#ff4444; color:white; border:none; padding:5px 10px; cursor:pointer; border-radius:4px;">X</button>
                        
                        <div class="form-group">
                            <label><input type="checkbox" onchange="updateNotice(${idx}, 'enabled', this.checked)" ${n.enabled ? 'checked' : ''}> Enable this notice</label>
                        </div>
                        <div class="form-group">
                            <label>Title</label>
                            <input type="text" onchange="updateNotice(${idx}, 'title', this.value)" value="${n.title || ''}" placeholder="Notice Title">
                        </div>
                        <div class="form-group">
                            <label>Message</label>
                            <textarea onchange="updateNotice(${idx}, 'message', this.value)" rows="3" placeholder="Notice Message">${n.message || ''}</textarea>
                        </div>
                        <div class="form-group">
                            <label>Button Text (Optional)</label>
                            <input type="text" onchange="updateNotice(${idx}, 'button_text', this.value)" value="${n.button_text || ''}" placeholder="E.g. Acknowledge">
                        </div>
                        <div class="form-group">
                            <label>Format / Theme</label>
                            <select onchange="updateNotice(${idx}, 'format', this.value)" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:4px;">
                                <option value="default" ${n.format === 'default' ? 'selected' : ''}>Default (Gold)</option>
                                <option value="danger" ${n.format === 'danger' ? 'selected' : ''}>Urgent (Red)</option>
                                <option value="info" ${n.format === 'info' ? 'selected' : ''}>Info (Blue)</option>
                            </select>
                        </div>
                    </div>
                `;
            });
            document.getElementById('notices_json').value = JSON.stringify(notices);
        }

        function updateNotice(idx, key, value) {
            notices[idx][key] = value;
            document.getElementById('notices_json').value = JSON.stringify(notices);
        }

        function addNotice() {
            notices.push({ enabled: true, title: '', message: '', button_text: 'Acknowledge', format: 'default' });
            renderNotices();
        }

        function removeNotice(idx) {
            if (confirm('Remove this notice?')) {
                notices.splice(idx, 1);
                renderNotices();
            }
        }

        renderNotices();

        // Clients Logic
        let clients = <%- JSON.stringify(data.clients || []) %>;
        if (clients.length === 0) {
            // Provide default placeholders matching the original hardcoded ones if empty
            clients = [
                { name: 'Hyteno Tech', logo_url: 'hytenotech.png' },
                { name: 'Thaha Investment Group', logo_url: 'thahainvestmentgroup.png' },
                { name: 'Samir Dance Studio', logo_url: 'samirdancestudio.png' },
                { name: 'Paramendo', logo_url: 'PARAMENDO.jpg' }
            ];
        }

        function renderClients() {
            const container = document.getElementById('clients-container');
            container.innerHTML = '';
            clients.forEach((c, idx) => {
                if (!c) return; 
                container.innerHTML += `
                    <div style="border: 1px solid #eee; padding: 15px; margin-bottom: 15px; border-radius: 4px; position:relative;">
                        <button type="button" onclick="removeClient(${idx})" style="position:absolute; right:15px; top:15px; background:#ff4444; color:white; border:none; padding:5px 10px; cursor:pointer; border-radius:4px;">X</button>
                        
                        <div class="form-group">
                            <label>Client Name</label>
                            <input type="text" onchange="updateClient(${idx}, 'name', this.value)" value="${c.name || ''}" placeholder="E.g. Apex Holdings">
                        </div>
                        <div class="form-group">
                            <label>Client Logo (Upload New)</label>
                            <input type="file" name="client_logo_file_${idx}" accept="image/jpeg, image/png, image/webp, image/svg+xml">
                            ${c.logo_url ? `<div style="margin-top:10px;"><small>Current Logo:</small><br><img src="${c.logo_url}" style="max-height: 50px; background: #ddd; padding: 5px; border-radius: 4px;"></div>` : ''}
                        </div>
                    </div>
                `;
            });
            document.getElementById('clients_json').value = JSON.stringify(clients);
        }

        function updateClient(idx, key, value) {
            clients[idx][key] = value;
            document.getElementById('clients_json').value = JSON.stringify(clients);
        }

        function addClient() {
            clients.push({ name: '', logo_url: '' });
            renderClients();
        }

        function removeClient(idx) {
            if (confirm('Remove this client?')) {
                clients.splice(idx, 1);
                renderClients();
            }
        }

        renderClients();
    </script>
</body>
</html>
